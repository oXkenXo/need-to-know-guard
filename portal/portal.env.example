# Copy to portal.env and fill in. Never commit portal.env (it contains passwords).
# Paths are relative to this folder; the defaults assume ../lab (Meridian Labs test environment).

# --- file server
NC_URL=http://localhost:8080
NC_ADMIN_USER=admin
NC_ADMIN_PASS=same-as-NC_ADMIN_PASSWORD-in-lab/.env

# --- mail server (leave IMAP_HOST empty to index files only)
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_CAFILE=../lab/certs/ca.crt
MAIL_DOMAIN=meridian.test
# alias file of the mail server: lists + forwarding rules (the "Revoke" action edits it)
MAIL_ALIASES=../lab/config/mail/postfix-virtual.cf

# --- directory (used by "Revoke" on a group membership)
LDAP_URL=ldap://localhost:389
LDAP_ADMIN_DN=cn=admin,dc=meridian,dc=test
LDAP_ADMIN_PASSWORD=same-as-LDAP_ADMIN_PASSWORD-in-lab/.env
LDAP_BASE=dc=meridian,dc=test

# --- lab only: employee passwords (the connector reads every mailbox and file listing) + answer key
ACCOUNTS_FILE=../lab/seed/accounts.env
ANSWER_KEY=../lab/seed/answer_key

# --- guard: tfidf (offline) | embedding | deberta (v5 guard from the notebook, English)
SCORER=tfidf
# GUARD_DIR=/path/to/need_to_know_guard/v5_seed42/guard
# three zones: score < THRESHOLD_LOW -> hold, > THRESHOLD_HIGH -> allow, in between -> ask the author
THRESHOLD_LOW=
THRESHOLD_HIGH=
# employees without history: ask (documents need the author's approval) | acl (server permissions only)
NEW_HIRE_MODE=ask

# --- assistant: none (quotes only) | ollama (recommended) | transformers
LLM=none
LLM_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# --- send notifications to the Nextcloud bell (access requests, revokes)
NOTIFY=0
HOST=127.0.0.1
PORT=7860
