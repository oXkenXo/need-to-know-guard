# Salin jadi portal.env lalu isi. JANGAN commit portal.env (berisi password admin).

# --- Nextcloud (storage server uji)
NC_URL=http://localhost:8080
NC_ADMIN_USER=admin
NC_ADMIN_PASS=isi-sama-dengan-ADMIN_PASSWORD-di-.env-storage
# password akun karyawan uji (dipakai konektor untuk membaca Nextcloud sebagai tiap karyawan)
AKUN_FILE=../storage/seed/accounts.env
# kunci jawaban storage uji (hanya untuk tabel evaluasi di panel admin; boleh dikosongkan)
MANIFEST=../storage/seed/manifest.csv

# --- Guard: tfidf (default, offline) | embedding (multibahasa, perlu sentence-transformers) | deberta (guard v5)
PENILAI=tfidf
# GUARD_DIR=../hasil_need_to_know_guard/v5_seed42/guard
# Ambang 3 zona (kosong = bawaan per penilai). skor < bawah -> tahan, > atas -> lolos, di antaranya -> tanya pemilik
AMBANG_BAWAH=
AMBANG_ATAS=
# karyawan tanpa histori: tanya (semua dokumen lewat persetujuan pemilik) | acl (hanya pakai izin Nextcloud)
MODE_KARYAWAN_BARU=tanya

# --- Chatbot: tanpa (kutipan saja) | ollama (disarankan, lihat README) | transformers
LLM=tanpa
LLM_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# --- kirim notifikasi ke lonceng Nextcloud (permintaan akses, hasil cabut)
KIRIM_NOTIFIKASI=0
HOST=127.0.0.1
PORT=7860
